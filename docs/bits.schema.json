{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MET-LIB-1.5 bits record",
  "type": "object",
  "required": [
    "protocol",
    "frontier_id",
    "b_phys",
    "b_orig",
    "kappa_hat",
    "frozen_at",
    "bits_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "MET-LIB-1.5" },
    "frontier_id": { "type": "string", "minLength": 1 },
    "b_phys": { "type": "integer", "enum": [0, 1] },
    "b_orig": { "type": "string", "enum": ["pred", "thm", "proto"] },
    "kappa_hat": {
      "type": "string",
      "enum": ["equilibre", "deficit", "non_contraint", "famille", "hors_domaine"]
    },
    "frozen_at": { "type": "string" },
    "bits_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
